    "jsx": "react-native",  // Override or add extra settings
    "strict": true,
    "baseUrl": "app/src",
    "paths": {
      "@icons/*": ["assets/icons/*"],
    },
    "types": ["react-native", "jest"],
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}